# Documentation only: start-dev.ps1 reads process environment, not .env files.
# The development JWT secret is managed separately in data/jwt-secret.txt.
PORT=8081
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=embeddinggemma:300m
OLLAMA_CHAT_MODEL=qwen3:4b
RAG_ENABLED=true
# Optional local Flashcards service key (never commit a real value).
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5
